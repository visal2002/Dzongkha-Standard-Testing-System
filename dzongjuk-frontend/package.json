{
  "name": "dzongjuk-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "vite build",
    "build:mock": "cross-env VITE_USE_MOCK_DATA=true vite build --mode test",
    "preview": "vite preview",
    "test": "cross-env VITE_USE_MOCK_DATA=true vitest run",
    "test:watch": "cross-env VITE_USE_MOCK_DATA=true vitest",
    "test:e2e": "npm run build:mock && playwright test",
    "test:e2e:local": "cross-env PLAYWRIGHT_CHANNEL=chrome npm run test:e2e",
    "test:e2e:ci": "npm run build:mock && playwright test --reporter=line"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-pdf/renderer": "^4.6.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.7.9",
    "framer-motion": "^11.15.0",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.6",
    "terser": "^5.49.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}

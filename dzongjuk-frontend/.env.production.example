# ============================================================
# DZONGJUK (DSTS) — PRODUCTION Environment Template
# Copy this to .env (or set as server environment variables).
# NEVER commit this file with real secrets to source control.
# ============================================================

# ── API Configuration ────────────────────────────────────────
# Base URL of the production backend REST API (no trailing slash)
VITE_API_BASE_URL=https://api.dsts.gov.bt/api/v1

# Request timeout in milliseconds (increase for slow networks)
VITE_API_TIMEOUT=15000

# ── Application ──────────────────────────────────────────────
VITE_APP_NAME=Dzongjuk DSTS
VITE_APP_VERSION=1.0.0

# ── NDI (National Digital Identity) OAuth ───────────────────
# Obtain production credentials from https://bhutanndi.com/developers
VITE_NDI_BASE_URL=https://wallet.bhutanndi.com
VITE_NDI_CLIENT_ID=<YOUR_PRODUCTION_NDI_CLIENT_ID>
VITE_NDI_REDIRECT_URI=https://dsts.gov.bt/auth/ndi/callback

# ── CRITICAL: Disable Mock Data in Production ────────────────
# This MUST be "false" in production.
# When true, all API calls return hardcoded test data.
# When false, the app connects to the real backend API.
VITE_USE_MOCK_DATA=false

# ── Security ─────────────────────────────────────────────────
# Disable API debug logging in production (prevents sensitive data leakage)
VITE_API_DEBUG=false

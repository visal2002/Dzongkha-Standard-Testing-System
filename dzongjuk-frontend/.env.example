# ============================================================
# DZONGJUK (DSTS) — Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to source control.
# ============================================================

# ── API Configuration ────────────────────────────────────────
# Base URL of the backend REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds
VITE_API_TIMEOUT=10000

# ── Application ──────────────────────────────────────────────
VITE_APP_NAME=Dzongjuk DSTS
VITE_APP_VERSION=1.0.0

# ── NDI (National Digital Identity) OAuth ───────────────────
# Obtain from https://bhutanndi.com/developers
VITE_NDI_BASE_URL=https://wallet.bhutanndi.com
VITE_NDI_CLIENT_ID=
VITE_NDI_REDIRECT_URI=http://localhost:5000/auth/ndi/callback

# ── Feature Flags (set to "true" to enable) ─────────────────
# When true, all API calls fall back to local mock data.
# Set to "false" once a real backend is connected.
VITE_USE_MOCK_DATA=true

# ── Development Helpers ──────────────────────────────────────
# Log API requests and responses to the browser console
VITE_API_DEBUG=false

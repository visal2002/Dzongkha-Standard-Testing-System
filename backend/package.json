{
  "name": "dzongjuk-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:all",
    "build:all": "nest build identity-service && nest build registration-service && nest build assessment-content-service && nest build result-service && nest build appeal-certificate-service && nest build notification-service && nest build reporting-service && nest build integration-service",
    "start:identity": "nest start identity-service --watch",
    "start:registration": "nest start registration-service --watch",
    "start:assessment": "nest start assessment-content-service --watch",
    "start:result": "nest start result-service --watch",
    "start:appeal": "nest start appeal-certificate-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:reporting": "nest start reporting-service --watch",
    "start:integration": "nest start integration-service --watch",
    "lint": "eslint \"{apps,libs,test,scripts}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:local-acceptance": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/local-acceptance.ts",
    "db:provision": "docker compose run --rm database-provisioner",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "overrides": {
    "js-yaml": "5.2.3",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}

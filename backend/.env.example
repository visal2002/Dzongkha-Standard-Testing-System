# ============================================================
# DZONGJUK (DSTS) - backend environment template
#
# Copy to .env and fill in. Never commit a filled-in .env.
#
# Every value below marked CHANGE-ME-... is a placeholder, not a secret. Each one
# is rejected at startup when NODE_ENV=production (libs/common/src/config-validation.ts),
# so a deployment that forgets to replace one fails to boot instead of running with
# a value that is published in this repository. Outside production the same finding
# is logged as a warning and the service still starts.
#
# Generate each secret separately - never reuse one across two settings:
#   openssl rand -base64 48          # JWT_SECRET, INTERNAL_SERVICE_SECRET, CERTIFICATE_VERIFICATION_SECRET
#   openssl rand -base64 32          # the 32-byte base64 keys: *_MASTER_KEY_BASE64, DATA_ENCRYPTION_KEY
#
# Startup validation never logs a configured value, only the name of the setting and
# what is wrong with it.
# ============================================================

NODE_ENV=development
# Signs and verifies every access token, and is shared by all services.
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=dzongjuk
DATABASE_PASSWORD=CHANGE-ME-local-postgres-password
# Each microservice owns a separate logical database. Common connection values
# remain fallbacks; any service may override HOST/PORT/USER/PASSWORD/SSL/POOL_MAX
# with the same prefix used by its *_DATABASE_NAME setting.
IDENTITY_DATABASE_NAME=dzongjuk_identity
REGISTRATION_DATABASE_NAME=dzongjuk_registration
ASSESSMENT_DATABASE_NAME=dzongjuk_assessment
RESULT_DATABASE_NAME=dzongjuk_result
APPEAL_CERTIFICATE_DATABASE_NAME=dzongjuk_appeal_certificate
NOTIFICATION_DATABASE_NAME=dzongjuk_notification
REPORTING_DATABASE_NAME=dzongjuk_reporting
INTEGRATION_DATABASE_NAME=dzongjuk_integration
RABBITMQ_URL=amqp://dzongjuk:CHANGE-ME-local-rabbitmq-password@localhost:5672
CORS_ORIGINS=http://localhost:5000
IDENTITY_PORT=8001
REGISTRATION_PORT=8002
ASSESSMENT_PORT=8003
RESULT_PORT=8004
APPEAL_PORT=8005
NOTIFICATION_PORT=8006
REPORTING_PORT=8007
INTEGRATION_PORT=8008
SESSION_IDLE_MINUTES=15
LOCKOUT_MINUTES=30
NDI_AUTHENTICATION_URL=https://staging.bhutanndi.com/authentication/v1/authenticate
NDI_VERIFIER_URL=https://demo-client.bhutanndi.com/verifier
NDI_WEBHOOK_URL=https://demo-client.bhutanndi.com/webhook
NDI_CLIENT_ID=
NDI_CLIENT_SECRET=
NDI_FOUNDATIONAL_ID_SCHEMA_URL=
NDI_WEBHOOK_ID=
NDI_WEBHOOK_BEARER_TOKEN=
NDI_PROOF_NAME=Dzongjuk Login - Verify Foundational ID
NDI_LOGIN_TTL_SECONDS=300
NDI_HTTP_TIMEOUT_MS=10000
NDI_ALLOW_TEST_TAKER_PROVISIONING=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=dzongjuk
S3_SECRET_KEY=CHANGE-ME-local-minio-secret-key
S3_SERVER_SIDE_ENCRYPTION=
ASSESSMENT_BUCKET=dzongjuk-assessment
# 32 bytes, base64. Encrypts stored question papers and answer sheets.
ASSESSMENT_MASTER_KEY_BASE64=
ASSESSMENT_KEY_VERSION=1
MAX_ASSESSMENT_FILE_BYTES=52428800
MALWARE_SCAN_URL=
MALWARE_SCAN_REQUIRED=false
SCORING_CONFIG_APPROVAL_REQUIRED=true
PRIVILEGED_ASSURANCE_LEVELS=MFA

# 32 bytes, base64. Encrypts band scores at rest in the result service. Leaving this
# unset falls back to the development key committed in
# apps/result-service/src/entities.ts, which is fine locally and refused outright
# when NODE_ENV=production. Changing it makes rows written under the previous key
# undecryptable, so treat a rotation as a data migration.
DATA_ENCRYPTION_KEY=
RESULT_SERVICE_URL=http://result-service:8004/api/v1
# Shared service-to-service secret. Public gateways strip the X-Internal-Service-Key
# header that carries it, so it is only ever presented over the internal network.
INTERNAL_SERVICE_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48
REGISTRATION_SERVICE_URL=http://registration-service:8002/api/v1
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CERTIFICATE_BUCKET=dzongjuk-certificates
# 32 bytes, base64. Encrypts archived certificate PDFs.
CERTIFICATE_MASTER_KEY_BASE64=
CERTIFICATE_KEY_VERSION=1
# Signs the QR verification token printed on every certificate. Rotating it
# invalidates the QR code on all previously issued certificates.
CERTIFICATE_VERIFICATION_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

# BIRMS staging integration. Credentials, agency code and service code are
# issued by the BIRMS team after agency/service registration; never expose
# these values through frontend environment variables.
# BIRMS_BASE_URL has no default in code. An unset or malformed value fails the
# request rather than falling back to the staging gateway, and a production build
# refuses to start pointed at a host named "staging"/"stagging" unless
# BIRMS_ALLOW_NON_PRODUCTION_HOST=true says so deliberately.
BIRMS_BASE_URL=https://birmsstagging.drc.gov.bt/api-services
BIRMS_SERVICE_PATH=moha-service/api/v1
BIRMS_USERNAME=
BIRMS_PASSWORD=
BIRMS_PLATFORM=Dzongjuk
BIRMS_AGENCY_CODE=
BIRMS_SERVICE_CODE=
BIRMS_SERVICE_DESCRIPTION=DSTS EXAMINATION REGISTRATION

# DCRC staging integration. Keep the consumer credentials server-side only.
DCRC_TOKEN_URL=https://stg-sso.tech.gov.bt/oauth2/token
DCRC_CITIZEN_URL=https://staging-datahub-apim.tech.gov.bt/dcrc_citizen_details_api/1.0.0/citizendetails
DCRC_CONSUMER_KEY=
DCRC_CONSUMER_SECRET=
DCRC_HTTP_TIMEOUT_MS=15000
DCRC_VERIFICATION_REQUIRED=false
INTEGRATION_SERVICE_URL=http://integration-service:8008/api/v1

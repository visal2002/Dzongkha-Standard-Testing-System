{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DSTS: Provision service databases",
      "type": "shell",
      "command": "npm run db:provision",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DSTS: Start all containers",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DSTS: Backend checks",
      "type": "shell",
      "command": "npm run lint && npm test && npm run build:all",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DSTS: Frontend build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/dzongjuk-frontend" },
      "problemMatcher": []
    }
  ]
}

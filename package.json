{
  "name": "dzongkha-standard-testing-system",
  "version": "1.0.0",
  "private": true,
  "description": "Developer command hub for the Dzongkha Standard Testing System",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm --prefix dzongjuk-frontend run dev",
    "frontend:build": "npm --prefix dzongjuk-frontend run build",
    "frontend:test": "npm --prefix dzongjuk-frontend test",
    "frontend:test:e2e": "npm --prefix dzongjuk-frontend run test:e2e:local",
    "backend:up": "docker compose -f backend/compose.yml up -d --build",
    "backend:down": "docker compose -f backend/compose.yml down",
    "backend:logs": "docker compose -f backend/compose.yml logs -f",
    "backend:status": "docker compose -f backend/compose.yml ps",
    "backend:build": "npm --prefix backend run build:all",
    "lint": "npm --prefix backend run lint",
    "test": "npm --prefix backend test",
    "test:acceptance": "npm --prefix backend run test:local-acceptance",
    "quality": "npm run frontend:test && npm run backend:build && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22"
  }
}
